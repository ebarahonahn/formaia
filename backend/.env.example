PORT=3000
WEB_ORIGIN=http://localhost:5500
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=formaia
MYSQL_USER=formaia_app
MYSQL_PASSWORD=replace_with_a_strong_password
TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Set to true only when the API is behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM="FormaIA <your_gmail_address@gmail.com>"
